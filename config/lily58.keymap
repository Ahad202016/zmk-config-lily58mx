#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define default_layer 0
#define lower_layer 1
#define raise_layer 2
#define adjust_layer 3
#define extra_layer 4

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                         &kp N6  &kp N7    &kp N8     &kp N9   &kp N0    &kp DEL
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                          &kp Y   &kp U     &kp I      &kp O    &kp P     &kp MINUS
&kp LCTRL  &kp A   &kp S   &kp D     &kp F     &kp G                          &kp H   &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V     &kp B   &kp LBKT     &kp RBKT  &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp LC(BACKSLASH)
                           &kp LALT  &kp LGUI  &mo 1   &kp SPACE    &kp RET   &mo 2   &kp BSPC  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "Lower";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&bt BT_CLR_ALL  &bt BT_SEL 0      &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3  &bt BT_SEL 4                           &studio_unlock  &to 3          &to 4          &kp K_NEXT  &kp K_PREVIOUS  &kp DEL
&kp F1          &kp F2            &kp F3             &kp F4             &kp F5        &kp F6                                 &kp F7          &kp F8         &kp F9         &kp F10     &kp F11         &kp F12
&kp GRAVE       &kp EXCL          &kp AT             &kp HASH           &kp DOLLAR    &kp PRCNT                              &kp CARET       &kp AMPS       &kp ASTRK      &kp LPAR    &kp RPAR        &kp TILDE
&kp LEFT_SHIFT  &ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG  &kp SLASH     &kp BACKSLASH  &trans       &trans     &kp EQUAL       &kp MINUS      &kp PLUS       &kp LBRC    &kp RBRC        &kp PIPE
                                                     &kp LEFT_ALT       &kp LEFT_GUI  &trans         &kp SPACE    &kp ENTER  &trans          &kp BACKSPACE  &kp RIGHT_GUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "Raise";

            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp GRAVE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                                                       &kp NUMBER_6  &kp NUMBER_7    &kp NUMBER_8    &kp NUMBER_9     &kp NUMBER_0      &to 0
&kp GRAVE  &kp N1        &kp N2        &kp N3        &kp N4        &kp N5                                                             &kp N6        &kp N7          &kp UP_ARROW    &kp N9           &to 5             &to 3
&kp F1     &kp F2        &kp F3        &kp F4        &kp F5        &kp F6                                                             &kp EQUAL     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp K_CALCULATOR  &to 4
&kp F7     &kp F8        &kp F9        &kp F10       &kp F11       &kp F12       &kp KP_LEFT_PARENTHESIS    &kp KP_RIGHT_PARENTHESIS  &kp PLUS      &kp MINUS       &kp KP_EQUAL    &kp KP_MULTIPLY  &kp SLASH         &kp BSLH
                                       &kp LEFT_ALT  &kp LEFT_GUI  &trans        &kp SPACE                  &kp ENTER                 &trans        &kp BACKSPACE   &kp RIGHT_GUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        numpad {
            display-name = "numpad";

            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp ESCAPE        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                          &kp K_VOLUME_UP    &kp KP_NUMLOCK   &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp KP_MINUS  &kp DELETE
&kp TAB           &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0                          &kp K_VOLUME_DOWN  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS   &to 4
&kp LEFT_CONTROL  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                                &kp K_PLAY_PAUSE   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_ENTER  &to 5
&kp LEFT_SHIFT    &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &kp F11      &kp F12    &kp K_MUTE         &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ENTER  &to 0
                                              &kp LEFT_ALT  &kp LEFT_GUI  &trans        &kp SPACE    &kp ENTER  &kp KP_NUMBER_0    &kp BACKSPACE    &kp KP_DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        gaming {
            display-name = "gaming";

            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp ESCAPE        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                          &kp NUMBER_6  &kp NUMBER_7    &kp NUMBER_8    &kp NUMBER_9     &kp NUMBER_0  &kp DELETE
&kp TAB           &kp F8        &kp Q         &kp W         &kp X         &kp R                                 &kp F6        &kp HOME        &kp UP_ARROW    &kp END          &to 0         &kp INSERT
&kp LEFT_CONTROL  &kp E         &kp A         &kp S         &kp D         &kp F                                 &kp F7        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &to 3         &kp PAGE_UP
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &kp B         &mkp LCLK    &mkp RCLK  &kp F8        &kp F9          &kp F10         &kp F11          &kp F12       &kp PAGE_DOWN
                                              &kp LEFT_ALT  &kp LEFT_GUI  &kp F11       &kp SPACE    &kp ENTER  &kp F12       &kp BACKSPACE   &kp RIGHT_GUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Experimental {
            bindings = <
&trans  &trans  &trans          &trans          &trans           &trans                    &trans  &trans               &trans               &trans            &trans  &trans
&trans  &trans  &trans          &mmv MOVE_UP    &trans           &trans                    &trans  &trans               &mmv MOVE_Y(100)     &trans            &trans  &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans                    &trans  &mmv (MOVE_X(-100))  &mmv (MOVE_Y(-100))  &mmv MOVE_X(100)  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans  &trans    &trans  &trans  &trans               &trans               &trans            &trans  &trans
                                &trans          &trans           &trans  &trans    &trans  &trans  &trans               &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>;
        };
    };
};
